# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=aegisgraph
# Read-only login (built-in role "reader") the Neo4j MCP server connects with. Create it:
#   CREATE USER aegis_reader SET PASSWORD '...' CHANGE NOT REQUIRED; GRANT ROLE reader TO aegis_reader;
# Requires dbms.security.auth_enabled=true and, for the MCP schema tool, APOC with
# dbms.security.procedures.unrestricted=apoc.meta.*
NEO4J_READER_USERNAME=aegis_reader
NEO4J_READER_PASSWORD=

# Retrieval: "agent" = an LLM writes read-only Cypher via the Neo4j MCP server
# (falls back to "fixed" on any failure); "fixed" = pre-written queries only.
RETRIEVAL_MODE=agent
# Agent LLM: any OpenAI-compatible endpoint. Free key at https://build.nvidia.com (~40 req/min).
# If it fails the agent retries on OpenRouter (OPENROUTER_API_KEY below) with AGENT_FALLBACK_MODEL.
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_API_KEY=
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AGENT_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Postgres (audit trail) - required
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/aegisgraph

# Default LLM: "ollama" (local Llama) or "openrouter" (hosted). Users can switch per question
# in the workspace; this is what is used until they do.
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Retrieval backend fail-safe. Neo4j is the primary store; set this to true to
# swap the retrieval layer (entity lookup, sent/received emails, etc.) over to
# the Postgres copy of the dataset instead, for comparison. Neo4j keeps running
# either way (health checks, security signals) -- only retrieval is swapped.
USE_POSTGRES_RETRIEVAL=false

# App Configuration
API_V1_STR=/api/v1
PROJECT_NAME=AegisGraph
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security (required): secret used to sign session tickets. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SESSION_SECRET=

# Login verification. CLERK_ISSUER is your Clerk "Frontend API URL"
# (the frontend's VITE_CLERK_PUBLISHABLE_KEY is issued by the same Clerk app).
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Comma-separated clerk_user_id:Role pairs. Role = Auditor | Analyst | Standard.
# Unlisted signed-in users are Standard. Auditor is also the admin role
# (the only one allowed to read the audit endpoints).
SECURITY_USER_ROLES=
# Local demos only: lets the "New Session" button reset remembered risk.
DEMO_ALLOW_RISK_RESET=false

# Admin security alerts (each channel stays off while blank).
# Telegram: create a bot with @BotFather for the token; send the bot a message,
# then open https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Gmail: SMTP_PASSWORD is a Google App Password (needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
